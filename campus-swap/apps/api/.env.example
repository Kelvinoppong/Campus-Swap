# Copy to .env and fill in. `npm run db:up` starts Postgres and Redis on these ports.
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_swap?schema=public
REDIS_URL=redis://localhost:6379

# Generate each with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-me-with-at-least-32-characters-of-random
JWT_REFRESH_SECRET=replace-me-with-a-different-32-plus-character-value
SIGN_IN_CODE_PEPPER=replace-me-with-another-32-plus-character-value

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Leave MAIL_DRY_RUN=true locally: sign-in codes print to the API log instead
# of being emailed, so you can sign in without a Resend account.
MAIL_DRY_RUN=true
RESEND_API_KEY=
MAIL_FROM=Campus Swap <login@campusswap.app>

CORS_ORIGINS=*
